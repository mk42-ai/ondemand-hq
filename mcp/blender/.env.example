# Copy this file to `.env` and adjust as needed. Never commit the real `.env`.

# Hostname/IP where a live Blender instance (running addon.py) is reachable.
# In Docker on macOS/Windows use "host.docker.internal"; on Linux either use
# the host's bridge IP or run the container with --network host.
BLENDER_HOST=localhost

# TCP port addon.py listens on inside Blender.
BLENDER_PORT=9876

# Port the streamable-HTTP transport binds to when running with
# `--transport http`.
MCP_HTTP_PORT=8080

# OnDemand platform API key, used by registration/automation scripts that
# call the OnDemand REST API (POST /plugin/v1, chat sessions, etc.).
# WARNING: never commit a real API key to version control. Leave this blank
# in any file that gets checked in and supply the real value out-of-band.
ONDEMAND_API_KEY=

# Enables the poly_haven_search / poly_haven_download tools.
POLYHAVEN_ENABLED=false

# Enables anonymous usage telemetry. Off by default in this project; the
# upstream ahujasid/blender-mcp project ships this ON by default.
TELEMETRY_ENABLED=false

# Comma-separated list of Origins allowed to call the streamable-HTTP /mcp
# endpoint, e.g. https://app.example.com,https://localhost:3000
MCP_ALLOWED_ORIGINS=

# Seconds to wait for a response from addon.py over the TCP socket.
BLENDER_TIMEOUT=15

# Number of times to retry a failed Blender TCP command before giving up.
BLENDER_RETRIES=3

# Master switch for the execute_blender_code tool (arbitrary, unsandboxed
# Python executed inside Blender's interpreter). Leave disabled unless every
# caller of this server is fully trusted.
EXEC_ENABLED=false

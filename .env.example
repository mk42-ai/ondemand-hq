# ODA Productivity Suite — environment configuration
# Copy to .env and fill in. The API key is server-side only; it NEVER ships to the browser.

# OnDemand API key (required) — https://app.on-demand.io
ONDEMAND_API_KEY=

# OnDemand API base URL (optional; default shown)
ONDEMAND_BASE_URL=https://api.on-demand.io

# Backend port (optional; default 8080)
PORT=8080

# Stream debug mode (Workstream 1) — ON by default at start.
# When true: every SSE event is logged server-side with ISO timestamp, event type,
# token/char count, and session/conversation id; the frontend debug drawer and the
# frame logs are written to the server console.
# Set to false to disable. (The UI footer also has a live toggle.)
STREAM_DEBUG=true

# ---------------------------------------------------------------------------
# DIRECT-TO-ONDEMAND MODE (browser talks to the gateway with no Node proxy).
# WARNING: VITE_ vars are inlined into the client bundle — the API key below is
# readable by anyone in devtools. Use a rotatable / scoped key.
# ---------------------------------------------------------------------------
# Turn direct mode on (default) or off ("false" -> use the server /api/chat path).
VITE_ONDEMAND_DIRECT=true
# The OnDemand API key exposed to the browser (usually the same value as ONDEMAND_API_KEY).
VITE_ONDEMAND_API_KEY=
# Gateway base URL (optional; default shown).
VITE_ONDEMAND_BASE_URL=https://api.on-demand.io
# Model endpoint + reasoning effort for direct chat (optional; defaults shown).
VITE_ONDEMAND_ENDPOINT_ID=predefined-glm-5.1
VITE_ONDEMAND_REASONING_EFFORT=low
# Attach ALL adopted plugins to every query (default true). Set false to send only
# the plugins the user explicitly selected.
VITE_ONDEMAND_ALL_PLUGINS=true
